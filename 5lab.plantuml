@startuml Автосервис

class Владелец {
  - имя: String
  - телефон: String
  + привезти(Автомобиль, СервисныйЦентр)
  + оплатить(Счет)
}

class Автомобиль {
  - госномер: String
  - марка: String
  - модель: String
  - годВыпуска: int
}

class СервисныйЦентр {
  - название: String
  - адрес: String
  + принятьАвтомобиль(Владелец, Автомобиль)
}

class Механик {
  - имя: String
  - специализация: String
  + провестиДиагностику(Автомобиль): Диагностика
  + определитьНеобходимое(Диагностика): СписокЗапчастей, СписокРабот
  + выполнитьРаботу(ЗаказНаряд)
}

class Менеджер {
  - имя: String
  - должность: String
  + составитьЗаказНаряд(СписокЗапчастей, СписокРабот, Владелец, Автомобиль): ЗаказНаряд
  + выставитьСчет(ЗаказНаряд): Счет
}

class Диагностика {
  - датаПроведения: Date
  - результат: String
  - описаниеНеисправностей: String
}

class Запчасть {
  - наименование: String
  - артикул: String
  - стоимость: double
  - количество: int
}

class Работа {
  - наименование: String
  - нормочас: double
  - стоимостьНормочаса: double
}

class ЗаказНаряд {
  - номер: String
  - датаОткрытия: Date
  - статус: String
  - итоговаяСтоимость: double
  + добавитьЗапчасть(Запчасть)
  + добавитьРаботу(Работа)
  + рассчитатьИтог()
}

class Счет {
  - номерСчета: String
  - датаВыставления: Date
  - суммаКОплте: double
  - статусОплаты: boolean
  + сформироватьПечатнуюФорму()
}

class СписокЗапчастей {
}

class СписокРабот {
}

' АГРЕГАЦИЯ 
Владелец "1" o-- "0..*" Автомобиль : владеет
СервисныйЦентр "1" o-- "0..*" Механик : нанимает
СервисныйЦентр "1" o-- "0..*" Менеджер : нанимает

' КОМПОЗИЦИЯ
СервисныйЦентр "1" *-- "0..*" ЗаказНаряд : формирует и архивирует
ЗаказНаряд "1" *-- "1" СписокЗапчастей : содержит
ЗаказНаряд "1" *-- "1" СписокРабот : содержит
СписокЗапчастей "1" *-- "1..*" Запчасть : включает
СписокРабот "1" *-- "1..*" Работа : включает

' АССОЦИАЦИЯ
Владелец "1" --> "0..*" ЗаказНаряд : является заказчиком
Диагностика "1" --> "1" Автомобиль : относится к
ЗаказНаряд "1" --> "0..1" Счет : сопровождается

' ЗАВИСИМОСТЬ
Механик ..> Диагностика : проводит
Механик ..> СписокЗапчастей : определяет
Механик ..> СписокРабот : определяет
Менеджер ..> ЗаказНаряд : составляет
Менеджер ..> Счет : выставляет
Владелец ..> Счет : оплачивает

@enduml