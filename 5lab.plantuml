@startuml Автосервис

class Владелец {
  - имя: String
  - телефон: String
  + привезти(Автомобиль, СервисныйЦентр)
  + оплатить(Счет)
}

class Автомобиль {
  - госномер: String
  - марка: String
  - модель: String
  - годВыпуска: int
}

class СервисныйЦентр {
  - название: String
  - адрес: String
  + принятьАвтомобиль(Владелец, Автомобиль)
}

class Механик {
  - имя: String
  - специализация: String
  + провестиДиагностику(Автомобиль): Диагностика
  + определитьНеобходимое(Диагностика): СписокЗапчастей, СписокРабот
  + выполнитьРаботу(ЗаказНаряд)
}

class Менеджер {
  - имя: String
  - должность: String
  + составитьЗаказНаряд(СписокЗапчастей, СписокРабот, Владелец, Автомобиль): ЗаказНаряд
  + выставитьСчет(ЗаказНаряд): Счет
}

class Диагностика {
  - датаПроведения: Date
  - результат: String
  - описаниеНеисправностей: String
}

class Запчасть {
  - наименование: String
  - артикул: String
  - стоимость: double
  - количество: int
}

class Работа {
  - наименование: String
  - нормочас: double
  - стоимостьНормочаса: double
}

class ЗаказНаряд {
  - номер: String
  - датаОткрытия: Date
  - статус: String
  - итоговаяСтоимость: double
  + добавитьЗапчасть(Запчасть)
  + добавитьРаботу(Работа)
  + рассчитатьИтог()
}

class Счет {
  - номерСчета: String
  - датаВыставления: Date
  - суммаКОплте: double
  - статусОплаты: boolean
  + сформироватьПечатнуюФорму()
}

class СписокЗапчастей {
}

class СписокРабот {
}

Владелец --> Автомобиль
Владелец --> ЗаказНаряд
Владелец --> Счет

СервисныйЦентр --> Механик
СервисныйЦентр --> Менеджер
СервисныйЦентр --> ЗаказНаряд

Механик --> Диагностика
Механик --> СписокЗапчастей
Механик --> СписокРабот

Менеджер --> ЗаказНаряд
Менеджер --> Счет

Диагностика --> Автомобиль

ЗаказНаряд --> Запчасть
ЗаказНаряд --> Работа
ЗаказНаряд --> Счет

СписокЗапчастей --> Запчасть
СписокРабот --> Работа

@enduml